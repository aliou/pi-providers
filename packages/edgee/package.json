{
  "name": "@aliou/pi-edgee",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "edgee",
    "provider",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-providers",
    "directory": "packages/edgee"
  },
  "pi": {
