{
  "name": "@aliou/pi-poolside",
  "version": "0.2.1",
  "description": "Pi extension package for the Poolside inference API.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "poolside"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-providers",
    "directory": "packages/poolside"
  },
  "pi": {
    "extensions": [
      "./extensions/provider/index.ts"
    ]
  },
  "publishConfig": {
