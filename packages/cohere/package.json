{
  "name": "@aliou/pi-cohere",
  "version": "0.1.2",
  "description": "Pi provider extension for Cohere models.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "cohere",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-providers",
    "directory": "packages/cohere"
  },
  "pi": {
    "extensions": [
      "./extensions/provider/index.ts"
    ],
    "video": "https://assets.aliou.me/github/aliou/pi-cohere/demo.mp4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "extensions",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.9.0",
    "@biomejs/biome": "^2.5.1",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
